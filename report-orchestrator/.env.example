# Local development — copy to .env and fill values.
# In AWS Lambda, the same keys are loaded from AWS Secrets Manager via Jenkins.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=marlo
DB_USER=marlo
DB_PASSWORD=

MQ_URL=
MQ_QUEUE_NAME=

MS_USERNAME=
MS_PASSWORD=
MS_BUCKET=microservice-reports
MS_S3_URL=
MS_REPORTING_URL=

REPORT_NAME_PREFIX=AICCRA

PDF_POLL_MAX_RETRIES=30
PDF_POLL_INTERVAL_MS=2000

REPORT_DRY_RUN=true
REPORT_SKIP_S3_POLL=false
