# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# MySQL (MARLO RDS — same schema as marlo-web)
# Copy values from marlo-web/src/main/resources/config/marlo-dev.properties / local DB setup
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marlo
DB_USER=marlo
DB_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Reporting microservice queue (marlo-dev: microservice.*)
# ---------------------------------------------------------------------------
MQ_URL=amqps://user:password@your-broker.mq.us-east-1.amazonaws.com:5671
MQ_QUEUE_NAME=cgiar_ms2_prod_reports_queue
MS_USERNAME=your-microservice-username
MS_PASSWORD=your-microservice-password
MS_BUCKET=microservice-reports
MS_S3_URL=https://microservice-reports.s3.us-east-1.amazonaws.com/
MS_REPORTING_URL=https://reports.prms.cgiar.org/api/

# ---------------------------------------------------------------------------
# Report naming
# ---------------------------------------------------------------------------
REPORT_NAME_PREFIX=AICCRA

# ---------------------------------------------------------------------------
# PDF polling (after queue publish)
# ---------------------------------------------------------------------------
PDF_POLL_MAX_RETRIES=30
PDF_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Local testing flags
# Set REPORT_DRY_RUN=true to build JSON only (no MQ / S3)
# Set REPORT_SKIP_S3_POLL=true to publish to MQ but skip waiting for PDF
# ---------------------------------------------------------------------------
REPORT_DRY_RUN=false
REPORT_SKIP_S3_POLL=false
