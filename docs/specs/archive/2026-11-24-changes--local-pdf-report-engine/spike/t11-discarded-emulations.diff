+      }
+      for (Node child : new ArrayList<Node>(parent.childNodes())) {
+        if (child instanceof TextNode && !((TextNode) child).isBlank()) {
+          Element wrapper = new Element("span");
+          child.before(wrapper);
+          wrapper.appendChild(child);
+        }
+      }
+    }
+  }
