+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.text.BreakIterator;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+/**
+ * Tests the line breaker that keeps an address whole the way ICU does (task T11).
+ */
+public class WebKitLineBreakerTest {
+
+  private static List<String> pieces(String text) {
+    WebKitLineBreaker breaker = new WebKitLineBreaker();
+    breaker.setText(text);
+    List<String> pieces = new ArrayList<String>();
+    int start = 0;
+    for (int end = breaker.next(); end != BreakIterator.DONE; end = breaker.next()) {
+      pieces.add(text.substring(start, end));
+      start = end;
+    }
+    return pieces;
+  }
+
+  @Test
+  public void anAddressIsNotCutAfterItsFullStops() {
+    assertEquals(Arrays.asList("Learn ", "more ", "in ", "www.scalingreadiness.org ", "now"),
+      pieces("Learn more in www.scalingreadiness.org now"));
+  }
+
+  @Test
+  public void aSeparatorBeforeALetterOrADigitIsNoBreakAndOneBeforeASpaceStillBreaksAtTheSpace() {
+    assertEquals(Arrays.asList("a.b ", "c,d ", "e:f ", "g;h ", "1.5 ", "end. ", "Next"),
+      pieces("a.b c,d e:f g;h 1.5 end. Next"));
+  }
+
+  @Test
+  public void theOtherBreakOpportunitiesOfTheJdkAreKept() {
+    assertEquals(Arrays.asList("well-", "known ", "a/b ", "(x) ", "y"), pieces("well-known a/b (x) y"));
+  }
+
+  @Test
+  public void anEmptyOrMissingTextHasNoBreaks() {
