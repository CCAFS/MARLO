+ * GNU General Public License for more details.
+ * You should have received a copy of the GNU General Public License
+ * along with MARLO. If not, see <http://www.gnu.org/licenses/>.
+ *****************************************************************/
+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import org.jsoup.nodes.Document;
+import org.jsoup.nodes.Element;
+
+/**
+ * A rough index of what the template's own CSS declares, enough to tell whether an author rule or an inline style
+ * sets a property on an element (CHG-LPRE-NF-001, task T11).
+ * <p>
+ * It is not a cascade: it does not rank rules, resolve inheritance or understand media queries. It answers one
+ * question, "does anything the author wrote address this property of this element", which is what the quirk
+ * emulations need before they apply a browser default the author did not override. A selector jsoup cannot parse
+ * matches nothing.
+ */
+final class AuthorStyles {
+
+  private static final Pattern RULE = Pattern.compile("([^{}]+)\\{([^{}]*)\\}");
+
+  private static final Pattern COMMENT = Pattern.compile("/\\*.*?\\*/", Pattern.DOTALL);
+
+  private static final class Rule {
+
+    private final List<String> selectors;
+
+    private final List<String> properties;
+
+    private final String declarations;
+
+    private Rule(List<String> selectors, List<String> properties, String declarations) {
+      this.selectors = selectors;
+      this.properties = properties;
+      this.declarations = declarations;
+    }
+  }
+
+  private final List<Rule> rules = new ArrayList<Rule>();
+
+  /** Indexes the {@code <style>} elements of {@code doc}. */
+  AuthorStyles(Document doc) {
+    for (Element style : doc.select("style")) {
+      String css = COMMENT.matcher(style.data()).replaceAll("");
+      Matcher matcher = RULE.matcher(css);
+      while (matcher.find()) {
+        String selectorText = matcher.group(1).trim();
+        if (selectorText.isEmpty() || selectorText.indexOf('@') >= 0) {
+          continue;
+        }
+        List<String> selectors = new ArrayList<String>();
+        for (String selector : selectorText.split(",")) {
+          if (!selector.trim().isEmpty()) {
+            selectors.add(selector.trim());
+          }
+        }
+        rules.add(new Rule(selectors, propertyNames(matcher.group(2)), matcher.group(2)));
+      }
+    }
+  }
+
+  /**
+   * Whether an author rule that matches {@code element}, or its inline style, declares one of the properties. A
+   * shorthand counts for its longhands: pass the shorthand too ({@code margin} with {@code margin-top}).
+   */
+  boolean declares(Element element, String... properties) {
+    if (declaresAny(propertyNames(element.attr("style")), properties)) {
+      return true;
+    }
+    for (Rule rule : rules) {
+      if (declaresAny(rule.properties, properties) && matches(rule, element)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * The value an author rule or the inline style gives {@code property} on {@code element}, lower case; the inline
+   * style wins, then the last matching rule in source order, without ranking by specificity. {@code null} when
+   * nothing declares it.
+   */
+  String valueOf(Element element, String property) {
+    String inline = valueIn(element.attr("style"), property);
+    if (inline != null) {
+      return inline;
+    }
+    String found = null;
+    for (Rule rule : rules) {
+      if (rule.properties.contains(property) && matches(rule, element)) {
+        String value = valueIn(rule.declarations, property);
+        if (value != null) {
+          found = value;
+        }
+      }
+    }
+    return found;
+  }
+
+  private static String valueIn(String declarations, String property) {
+    String found = null;
+    for (String declaration : declarations.split(";")) {
+      int colon = declaration.indexOf(':');
+      if (colon > 0 && declaration.substring(0, colon).trim().toLowerCase(Locale.ROOT).equals(property)) {
+        found = declaration.substring(colon + 1).trim().toLowerCase(Locale.ROOT);
+      }
+    }
+    return found;
+  }
+
+  private static boolean declaresAny(List<String> declared, String[] wanted) {
+    for (String property : wanted) {
+      if (declared.contains(property)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static boolean matches(Rule rule, Element element) {
+    for (String selector : rule.selectors) {
+      try {
+        if (element.is(selector)) {
+          return true;
+        }
+      } catch (RuntimeException e) {
+        // A selector jsoup does not understand cannot be matched; it addresses nothing here.
+        continue;
+      }
+    }
+    return false;
+  }
+
+  private static List<String> propertyNames(String declarations) {
+    List<String> names = new ArrayList<String>();
+    for (String declaration : declarations.split(";")) {
+      int colon = declaration.indexOf(':');
+      if (colon > 0) {
+        names.add(declaration.substring(0, colon).trim().toLowerCase(Locale.ROOT));
+      }
+    }
+    return names;
+  }
+}
