+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Document;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Tests the rough index of what the template's own CSS declares (task T11).
+ */
+public class AuthorStylesTest {
+
+  private static Document doc(String css, String body) {
+    return Jsoup.parse("<html><head><style>" + css + "</style></head><body>" + body + "</body></html>");
+  }
+
+  @Test
+  public void aRuleThatMatchesTheElementDeclaresItsProperties() {
+    Document doc = doc("p { margin: 5px 0; } .a, td > span { color: red; font-size: 9px; }",
+      "<p id=\"p\">x</p><table><tr><td><span id=\"s\">y</span></td></tr></table><div class=\"a\" id=\"d\">z</div>");
+    AuthorStyles styles = new AuthorStyles(doc);
+    assertTrue(styles.declares(doc.getElementById("p"), "margin"));
+    assertFalse("a shorthand does not declare its longhand by itself",
+      styles.declares(doc.getElementById("p"), "margin-top"));
+    assertTrue(styles.declares(doc.getElementById("p"), "margin-top", "margin"));
+    assertTrue("any selector of a list", styles.declares(doc.getElementById("s"), "font-size"));
+    assertTrue(styles.declares(doc.getElementById("d"), "color"));
+    assertFalse("a rule for another element", styles.declares(doc.getElementById("d"), "margin"));
+  }
+
+  @Test
+  public void theInlineStyleCountsToo() {
+    Document doc = doc("", "<p id=\"p\" style=\"margin-top: 3px; COLOR : red\">x</p>");
+    AuthorStyles styles = new AuthorStyles(doc);
+    assertTrue(styles.declares(doc.getElementById("p"), "margin-top"));
+    assertTrue("names are compared in lower case", styles.declares(doc.getElementById("p"), "color"));
+    assertEquals("3px", styles.valueOf(doc.getElementById("p"), "margin-top"));
+  }
+
+  @Test
+  public void theValueIsTheInlineOneThenTheLastMatchingRuleInLowerCase() {
+    Document doc = doc("p { position: Fixed; top: 1px; } p.x { position: ABSOLUTE; }",
+      "<p id=\"a\" class=\"x\">x</p><p id=\"b\">y</p><p id=\"c\" style=\"position: static\">z</p>");
+    AuthorStyles styles = new AuthorStyles(doc);
+    assertEquals("absolute", styles.valueOf(doc.getElementById("a"), "position"));
+    assertEquals("fixed", styles.valueOf(doc.getElementById("b"), "position"));
+    assertEquals("static", styles.valueOf(doc.getElementById("c"), "position"));
+    assertNull(styles.valueOf(doc.getElementById("b"), "bottom"));
+  }
+
+  @Test
+  public void commentsAtRulesAndSelectorsJsoupCannotParseAreIgnored() {
+    Document doc = doc("/* p { color: red; } */ @page { margin: 3px; } p:unknown-pseudo(2) { color: blue; }"
+      + " @media print { .m { page-break-after: always; } } p { font-size: 9px; }", "<p id=\"p\" class=\"m\">x</p>");
+    AuthorStyles styles = new AuthorStyles(doc);
+    assertFalse(styles.declares(doc.getElementById("p"), "color"));
+    assertFalse(styles.declares(doc.getElementById("p"), "margin"));
+    assertTrue(styles.declares(doc.getElementById("p"), "font-size"));
+    assertEquals("a rule inside @media print applies when printing", "always",
+      styles.valueOf(doc.getElementById("p"), "page-break-after"));
+  }
+}
