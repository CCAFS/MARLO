+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import com.openhtmltopdf.extend.FontContext;
+import com.openhtmltopdf.pdfboxout.PdfBoxFSFontMetrics;
+import com.openhtmltopdf.pdfboxout.PdfBoxTextRenderer;
+import com.openhtmltopdf.render.FSFont;
+import com.openhtmltopdf.render.FSFontMetrics;
+
+/**
+ * Text renderer whose font metrics follow PhantomJS (CHG-LPRE-NF-001, design section 7.4, task T11).
+ * <p>
+ * PhantomJS reads the ascent and the descent of a font hinted at its pixel size, which rounds both up to whole CSS
+ * pixels, so a line of {@code line-height: normal} text is {@code ceil(ascent) + ceil(descent)} pixels high: 13 px
+ * for 10 px DejaVu Sans, 17 px for 14 px, 19 px for 16 px (probed on the production pipeline for sizes 6 to 48 px).
+ * OpenHTMLtoPDF uses the unrounded metrics (11.64 px for 10 px), which makes every line shorter and lets the
+ * difference accumulate down the page. Only the ascent and the descent are changed; widths and kerning are not.
+ */
+final class PhantomJsTextRenderer extends PdfBoxTextRenderer {
+
+  /** Metrics are computed in float dots: a value this close below an integer pixel is that integer. */
+  private static final float EPSILON = 0.001f;
+
+  private final int dotsPerPixel;
+
+  PhantomJsTextRenderer(int dotsPerPixel) {
+    this.dotsPerPixel = dotsPerPixel;
+  }
+
+  @Override
+  public FSFontMetrics getFSFontMetrics(FontContext context, FSFont font, String text) {
+    FSFontMetrics metrics = super.getFSFontMetrics(context, font, text);
+    if (metrics instanceof PdfBoxFSFontMetrics) {
+      PdfBoxFSFontMetrics rounded = (PdfBoxFSFontMetrics) metrics;
+      rounded.setAscent(wholePixels(rounded.getAscent()));
+      rounded.setDescent(wholePixels(rounded.getDescent()));
+    }
+    return metrics;
+  }
+
+  /** Rounds a length in dots up to a whole number of CSS pixels. */
+  private float wholePixels(float dots) {
+    return (float) Math.ceil(dots / dotsPerPixel - EPSILON) * dotsPerPixel;
+  }
+}
diff --git a/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/TrueTypeTables.java b/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/TrueTypeTables.java
