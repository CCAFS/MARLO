+      Node child = atStart ? firstContent(current) : lastContent(current);
+      if (!(child instanceof Element)) {
+        return null;
+      }
+      Element element = (Element) child;
+      if (!TRANSPARENT_TAGS.contains(element.tagName())) {
+        return element;
+      }
