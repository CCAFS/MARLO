+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.text.BreakIterator;
+import java.util.Locale;
+
+import com.openhtmltopdf.extend.FSTextBreaker;
+
+/**
+ * Line breaks as WebKit (ICU) takes them (CHG-LPRE-NF-001, design section 7.4, task T11).
+ * <p>
+ * The JDK's line {@link BreakIterator} may break after a full stop, comma, colon or semicolon even when a letter or
+ * a digit follows, so {@code www.scalingreadiness.org} is cut after {@code www.}. ICU keeps such a word whole
+ * (UAX 14, the rules for infix separators), and so does html-pdf: the whole address moves to the next line. This
+ * breaker skips those boundaries and keeps all the others.
+ * <p>
+ * It holds the text it iterates over, so a renderer needs an instance of its own; it is not thread safe.
+ */
+final class WebKitLineBreaker implements FSTextBreaker {
+
+  private static final String INFIX_SEPARATORS = ".,:;";
+
+  private final BreakIterator breaks = BreakIterator.getLineInstance(Locale.ROOT);
+
+  private String text = "";
+
+  @Override
+  public int next() {
+    int boundary = breaks.next();
+    while (boundary != BreakIterator.DONE && boundary < text.length() && isInsideWord(boundary)) {
+      boundary = breaks.next();
+    }
+    return boundary;
+  }
+
+  @Override
+  public void setText(String newText) {
+    text = newText == null ? "" : newText;
+    breaks.setText(text);
+  }
+
+  /** A boundary between an infix separator and the letter or digit after it is no break opportunity. */
+  private boolean isInsideWord(int boundary) {
+    return boundary > 0 && INFIX_SEPARATORS.indexOf(text.charAt(boundary - 1)) >= 0
+      && Character.isLetterOrDigit(text.charAt(boundary));
+  }
+}
diff --git a/marlo-web/src/main/resources/pdf/html-pdf-defaults.css b/marlo-web/src/main/resources/pdf/html-pdf-defaults.css
new file mode 100644
index 0000000000..18cdd695c6
--- /dev/null
+++ b/marlo-web/src/main/resources/pdf/html-pdf-defaults.css
@@ -0,0 +1,15 @@
+/*
+ * WebKit's default stylesheet as html-pdf (PhantomJS 2.1, QtWebKit) applies it to the vertical rhythm of text blocks.
+ * OpenHTMLtoPDF's own defaults differ (p, h4 and lists 1.12em; h2 .75em; h3 .83em; h5 1.5em; h6 1.67em), and
+ * every template that leaves these margins to the browser drifts by a few points per block. Loaded FIRST in <head>,
+ * so any rule of the template overrides it, as it overrides a browser default. Task T11; probed on the production
+ * pipeline.
+ */
+p, ul, ol, dl, blockquote, pre, menu, dir { margin-top: 1em; margin-bottom: 1em; }
+ol ul, ul ol, ul ul, ol ol { margin-top: 0; margin-bottom: 0; }
+h1 { margin-top: .67em; margin-bottom: .67em; }
+h2 { margin-top: .83em; margin-bottom: .83em; }
+h3 { margin-top: 1em; margin-bottom: 1em; }
+h4 { margin-top: 1.33em; margin-bottom: 1.33em; }
+h5 { font-size: .83em; margin-top: 1.67em; margin-bottom: 1.67em; }
+h6 { font-size: .67em; margin-top: 2.33em; margin-bottom: 2.33em; }
