index 0000000000..69c9c8714a
--- /dev/null
+++ b/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/TrueTypeTables.java
@@ -0,0 +1,96 @@
+/*****************************************************************
+ * This file is part of Managing Agricultural Research for Learning &
+ * Outcomes Platform (MARLO).
+ * MARLO is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * at your option) any later version.
+ * MARLO is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ * You should have received a copy of the GNU General Public License
+ * along with MARLO. If not, see <http://www.gnu.org/licenses/>.
+ *****************************************************************/
+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+/**
+ * Edits the table directory of a TrueType font held in memory (CHG-LPRE-NF-001, design section 7.4, task T11).
+ * <p>
+ * PDFBox applies the font's own glyph substitution table (GSUB) when it writes text, so "fi", "ff" and "ffi" come
+ * out as ligature glyphs and text extraction finds {@code U+FB01} where html-pdf's PDF holds the two letters.
+ * Dropping the table from the directory of the font bytes handed to the renderer turns the ligatures off; the
+ * embedded subset never carried that table anyway, and no font file is modified on disk.
+ */
+final class TrueTypeTables {
+
+  private static final int HEADER_LENGTH = 12;
+
+  private static final int RECORD_LENGTH = 16;
+
+  private static final int TAG_LENGTH = 4;
+
+  private static final int NUM_TABLES_OFFSET = 4;
+
+  /**
+   * Returns a copy of {@code font} whose table directory does not list {@code tag}; the table data stays where it
+   * is, unreferenced. A font that does not list the tag, or that is not a plain sfnt, is returned as it is.
+   *
+   * @param font the bytes of a TrueType font.
+   * @param tag the four-letter table tag, for example {@code GSUB}.
+   * @return the edited copy, or {@code font} itself when there is nothing to remove.
+   */
+  static byte[] without(byte[] font, String tag) {
+    if (font == null || font.length < HEADER_LENGTH) {
+      return font;
+    }
+    int tables = unsignedShort(font, NUM_TABLES_OFFSET);
+    if (HEADER_LENGTH + (long) tables * RECORD_LENGTH > font.length) {
+      return font;
+    }
+    byte[] wanted = tag.getBytes(StandardCharsets.US_ASCII);
+    int found = -1;
+    for (int i = 0; i < tables && found < 0; i++) {
+      int record = HEADER_LENGTH + i * RECORD_LENGTH;
+      boolean same = wanted.length == TAG_LENGTH;
+      for (int k = 0; k < TAG_LENGTH && same; k++) {
+        same = font[record + k] == wanted[k];
+      }
+      if (same) {
+        found = i;
+      }
+    }
+    if (found < 0) {
+      return font;
+    }
+    byte[] edited = font.clone();
+    int first = HEADER_LENGTH + found * RECORD_LENGTH;
+    int end = HEADER_LENGTH + tables * RECORD_LENGTH;
+    System.arraycopy(font, first + RECORD_LENGTH, edited, first, end - first - RECORD_LENGTH);
+    Arrays.fill(edited, end - RECORD_LENGTH, end, (byte) 0);
+    int remaining = tables - 1;
+    int entrySelector = remaining == 0 ? 0 : 31 - Integer.numberOfLeadingZeros(remaining);
+    int searchRange = (1 << entrySelector) * RECORD_LENGTH;
+    putShort(edited, NUM_TABLES_OFFSET, remaining);
+    putShort(edited, NUM_TABLES_OFFSET + 2, searchRange);
+    putShort(edited, NUM_TABLES_OFFSET + 4, entrySelector);
+    putShort(edited, NUM_TABLES_OFFSET + 6, remaining * RECORD_LENGTH - searchRange);
+    return edited;
+  }
+
+  private static void putShort(byte[] data, int offset, int value) {
+    data[offset] = (byte) (value >> 8);
+    data[offset + 1] = (byte) value;
+  }
+
+  private static int unsignedShort(byte[] data, int offset) {
+    return ((data[offset] & 0xFF) << 8) | (data[offset + 1] & 0xFF);
+  }
+
+  private TrueTypeTables() {
+  }
+}
diff --git a/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/WebKitLineBreaker.java b/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/WebKitLineBreaker.java
