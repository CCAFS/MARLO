+      "<div style=\"width: 120px; font-size: 10px\">Learn more in www.scalingreadiness.org</div>");
+    try (PDDocument document = open(pdf)) {
+      PDFTextStripper stripper = new PDFTextStripper();
+      stripper.setSortByPosition(true);
