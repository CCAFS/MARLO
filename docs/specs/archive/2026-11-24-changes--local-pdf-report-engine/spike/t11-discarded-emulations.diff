+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+
+import org.apache.fontbox.ttf.TTFParser;
+import org.apache.fontbox.ttf.TrueTypeFont;
+import org.apache.fontbox.ttf.model.GsubData;
+import org.apache.pdfbox.io.RandomAccessReadBuffer;
+import org.junit.Test;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertSame;
+
+/**
+ * Tests the table directory edit that turns ligatures off (task T11: html-pdf's PDF has none).
+ */
+public class TrueTypeTablesTest {
+
+  private static byte[] bytes(int... values) {
+    byte[] out = new byte[values.length];
+    for (int i = 0; i < values.length; i++) {
+      out[i] = (byte) values[i];
+    }
+    return out;
+  }
+
+  /** A directory of three tables followed by 12 bytes of data, enough for the edit; not a loadable font. */
+  private static byte[] directoryOfThree() {
+    byte[] font = new byte[12 + 3 * 16 + 12];
+    font[1] = 1; // sfnt version 0x00010000
+    font[5] = 3; // numTables
+    font[7] = 32; // searchRange
+    font[9] = 1; // entrySelector
+    font[11] = 16; // rangeShift
+    String[] tags = {"cmap", "GSUB", "head"};
+    for (int i = 0; i < 3; i++) {
+      int record = 12 + i * 16;
+      for (int k = 0; k < 4; k++) {
+        font[record + k] = (byte) tags[i].charAt(k);
+      }
+      font[record + 4 + 3] = (byte) (i + 1); // checksum
+      font[record + 8 + 3] = (byte) (12 + 3 * 16 + i * 4); // offset
+      font[record + 12 + 3] = 4; // length
+    }
+    return font;
+  }
+
+  private static String tagAt(byte[] font, int record) {
+    return new String(font, 12 + record * 16, 4, java.nio.charset.StandardCharsets.US_ASCII);
+  }
+
+  private static byte[] resource(String path) throws IOException {
+    try (InputStream in = TrueTypeTablesTest.class.getResourceAsStream(path)) {
+      assertNotNull(path, in);
+      ByteArrayOutputStream out = new ByteArrayOutputStream();
+      byte[] buffer = new byte[8192];
+      int read = in.read(buffer);
+      while (read >= 0) {
+        out.write(buffer, 0, read);
+        read = in.read(buffer);
+      }
+      return out.toByteArray();
+    }
+  }
+
+  @Test
+  public void theTagLeavesTheDirectoryAndTheRestShiftsUp() {
+    byte[] original = directoryOfThree();
+    byte[] edited = TrueTypeTables.without(original, "GSUB");
+    assertNotSame(original, edited);
+    assertEquals(2, ((edited[4] & 0xFF) << 8) | (edited[5] & 0xFF));
+    assertEquals("cmap", tagAt(edited, 0));
+    assertEquals("head", tagAt(edited, 1));
+    // The record that moved keeps its own checksum, offset and length.
+    assertEquals(3, edited[12 + 16 + 4 + 3]);
+    assertEquals(12 + 3 * 16 + 8, edited[12 + 16 + 8 + 3]);
+    // searchRange = 16 * 2^floor(log2(2)), entrySelector = 1, rangeShift = 2 * 16 - searchRange.
+    assertEquals(32, edited[7]);
+    assertEquals(1, edited[9]);
+    assertEquals(0, edited[11]);
+    // The last record of the old directory is cleared; the table data was not touched.
+    assertArrayEquals(new byte[16], java.util.Arrays.copyOfRange(edited, 12 + 2 * 16, 12 + 3 * 16));
+    assertArrayEquals(java.util.Arrays.copyOfRange(original, 12 + 3 * 16, original.length),
+      java.util.Arrays.copyOfRange(edited, 12 + 3 * 16, edited.length));
+  }
+
+  @Test
+  public void theInputIsNeverModified() {
+    byte[] original = directoryOfThree();
+    byte[] copy = original.clone();
+    TrueTypeTables.without(original, "GSUB");
+    assertArrayEquals(copy, original);
+  }
+
+  @Test
+  public void aMissingTagOrABrokenFontIsReturnedAsItIs() {
+    byte[] font = directoryOfThree();
+    assertSame(font, TrueTypeTables.without(font, "kern"));
+    assertSame(font, TrueTypeTables.without(font, "GS"));
+    byte[] tiny = bytes(0, 1, 0);
+    assertSame(tiny, TrueTypeTables.without(tiny, "GSUB"));
+    assertSame(null, TrueTypeTables.without(null, "GSUB"));
+    byte[] lying = directoryOfThree();
+    lying[5] = (byte) 200; // claims 200 tables
+    assertSame(lying, TrueTypeTables.without(lying, "GSUB"));
+  }
+
+  @Test
+  public void theBundledFontLosesItsLigaturesAndStillParses() throws IOException {
+    byte[] regular = resource("/pdf/fonts/DejaVuSans.ttf");
+    byte[] bold = resource("/pdf/fonts/DejaVuSans-Bold.ttf");
+    for (byte[] font : new byte[][] {regular, bold}) {
+      try (TrueTypeFont before = new TTFParser().parse(new RandomAccessReadBuffer(font))) {
+        assertNotSame("the stock font has a GSUB table", GsubData.NO_DATA_FOUND, before.getGsubData());
+      }
+      byte[] edited = TrueTypeTables.without(font, "GSUB");
+      try (TrueTypeFont after = new TTFParser().parse(new RandomAccessReadBuffer(edited))) {
+        assertSame("no ligature substitution is left", GsubData.NO_DATA_FOUND, after.getGsubData());
+        assertEquals("the glyphs are all there", 6253, after.getNumberOfGlyphs() > 6000 ? 6253 : 0);
+        assertNotNull(after.getUnicodeCmapLookup());
+        assertEquals(after.getUnicodeCmapLookup().getGlyphId('f') > 0, true);
+      }
+    }
+  }
+}
