+ * along with MARLO. If not, see <http://www.gnu.org/licenses/>.
+ *****************************************************************/
+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.Locale;
+
+import org.apache.pdfbox.cos.COSName;
+import org.apache.pdfbox.pdmodel.PDDocument;
+import org.apache.pdfbox.pdmodel.PDPage;
+import org.apache.pdfbox.pdmodel.PDPageContentStream;
+import org.apache.pdfbox.pdmodel.PDPageContentStream.AppendMode;
+import org.apache.pdfbox.pdmodel.common.PDRectangle;
+import org.apache.pdfbox.pdmodel.interactive.action.PDAction;
+import org.apache.pdfbox.pdmodel.interactive.action.PDActionGoTo;
+import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotation;
+import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationLink;
+import org.apache.pdfbox.pdmodel.interactive.documentnavigation.destination.PDDestination;
+import org.apache.pdfbox.pdmodel.interactive.documentnavigation.destination.PDPageXYZDestination;
+
+/**
+ * Scales every page of a rendered PDF about the origin (CHG-LPRE-NF-001, design section 7.4, task T11).
+ * <p>
+ * OpenHTMLtoPDF measures layout in whole "dots per pixel", so one CSS pixel is {@code dotsPerPixel / 26.667}
+ * points, which is never exactly 1. html-pdf (PhantomJS) prints one CSS pixel as exactly one point. The renderer
+ * therefore lays the page out in its own scale and this class brings the finished pages to the html-pdf scale: the
+ * content is wrapped in a {@code cm} matrix and the page boxes, link rectangles and link destinations follow.
+ */
+final class PdfPageScaler {
+
+  /**
+   * Scales the pages of {@code pdf} by {@code factor}.
+   *
+   * @param pdf the rendered document, modified in place.
+   * @param factor the scale to apply to the page content and boxes; 1 leaves the document untouched.
+   * @throws IOException when a content stream cannot be written.
+   */
+  static void scale(PDDocument pdf, double factor) throws IOException {
+    if (factor == 1.0) {
+      return;
+    }
+    String matrix = String.format(Locale.ROOT, "q %1$.9f 0 0 %1$.9f 0 0 cm\n", factor);
+    for (PDPage page : pdf.getPages()) {
+      try (PDPageContentStream before = new PDPageContentStream(pdf, page, AppendMode.PREPEND, false, false)) {
+        before.appendRawCommands(matrix);
+      }
+      try (PDPageContentStream after = new PDPageContentStream(pdf, page, AppendMode.APPEND, false, false)) {
+        after.appendRawCommands("Q\n");
+      }
+      // The crop box is read through the media box, so it is taken before the media box changes.
+      PDRectangle crop = page.getCOSObject().containsKey(COSName.CROP_BOX) ? page.getCropBox() : null;
+      page.setMediaBox(scaled(page.getMediaBox(), factor));
+      if (crop != null) {
+        page.setCropBox(scaled(crop, factor));
+      }
+      scaleAnnotations(page, factor);
+    }
+  }
+
+  private static PDRectangle scaled(PDRectangle box, double factor) {
+    float f = (float) factor;
+    return new PDRectangle(box.getLowerLeftX() * f, box.getLowerLeftY() * f, box.getWidth() * f,
+      box.getHeight() * f);
+  }
+
+  private static void scaleAnnotations(PDPage page, double factor) throws IOException {
+    List<PDAnnotation> annotations = page.getAnnotations();
+    for (PDAnnotation annotation : annotations) {
+      PDRectangle rectangle = annotation.getRectangle();
+      if (rectangle != null) {
+        annotation.setRectangle(scaled(rectangle, factor));
+      }
+      if (annotation instanceof PDAnnotationLink) {
+        PDAnnotationLink link = (PDAnnotationLink) annotation;
+        scaleDestination(link.getDestination(), factor);
+        PDAction action = link.getAction();
+        if (action instanceof PDActionGoTo) {
+          scaleDestination(((PDActionGoTo) action).getDestination(), factor);
+        }
+      }
+    }
+  }
+
+  private static void scaleDestination(PDDestination destination, double factor) {
+    if (destination instanceof PDPageXYZDestination) {
+      PDPageXYZDestination xyz = (PDPageXYZDestination) destination;
+      if (xyz.getLeft() >= 0) {
+        xyz.setLeft((int) Math.round(xyz.getLeft() * factor));
+      }
+      if (xyz.getTop() >= 0) {
+        xyz.setTop((int) Math.round(xyz.getTop() * factor));
+      }
+    }
+  }
+
+  private PdfPageScaler() {
+  }
+}
diff --git a/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/PhantomJsTextRenderer.java b/marlo-web/src/main/java/org/cgiar/ccafs/marlo/utils/pdf/PhantomJsTextRenderer.java
