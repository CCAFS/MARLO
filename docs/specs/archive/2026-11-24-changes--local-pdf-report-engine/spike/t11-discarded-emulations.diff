+      assertEquals("page width", 595.0, document.getPage(0).getMediaBox().getWidth(), 0.01);
+      assertEquals("page height", 842.0, document.getPage(0).getMediaBox().getHeight(), 0.01);
+    }
+    float width = 0;
+    for (TextPosition position : glyphsOf(pdf).all) {
+      width += position.getWidthDirAdj();
+    }
+    // Ten DejaVu Sans "W" (2025 / 2048 em) at 20 px: 197.8 points when one pixel is one point, 200.3 at the
+    // 1.0125 the dots-per-pixel of 27 gave, 148.3 at OpenHTMLtoPDF's 0.75.
+    assertEquals(197.8, width, 0.5);
+  }
+
+  @Test
+  public void aLineOfNormalHeightIsTheRoundedUpAscentPlusTheRoundedUpDescent() throws Exception {
+    byte[] pdf = renderBody("<div style=\"font-size: 10px\">a<br>b<br>c</div>"
+      + "<div style=\"font-size: 14px\">d<br>e</div><div style=\"font-size: 16px\">f<br>g</div>");
+    List<TextPosition> glyphs = glyphsOf(pdf).all;
+    List<Float> baselines = new ArrayList<Float>();
+    for (TextPosition glyph : glyphs) {
+      baselines.add(glyph.getYDirAdj());
+    }
+    assertEquals(7, baselines.size());
+    // 10 px: ceil(9.28) + ceil(2.36) = 13; 14 px: 13 + 4 = 17; 16 px: 15 + 4 = 19 (probed on PhantomJS)
+    assertEquals(13.0, baselines.get(1) - baselines.get(0), 0.05);
+    assertEquals(13.0, baselines.get(2) - baselines.get(1), 0.05);
+    assertEquals(17.0, baselines.get(4) - baselines.get(3), 0.05);
+    assertEquals(19.0, baselines.get(6) - baselines.get(5), 0.05);
+  }
+
+  @Test
