+  @Test
+  public void theTextOfALineIsWrittenInReadingOrderAroundAnInlineElement() throws Exception {
+    byte[] pdf = renderBody(
+      "<p style=\"font-size: 12px\">aa <b>BBB</b>, cc <span style=\"color: red\">DD</span>ee</p>");
+    try (PDDocument document = open(pdf)) {
+      assertEquals("aaBBB,ccDDee", squash(new PDFTextStripper().getText(document)));
+    }
