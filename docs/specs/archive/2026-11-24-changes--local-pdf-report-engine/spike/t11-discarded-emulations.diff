+ *****************************************************************/
+
+package org.cgiar.ccafs.marlo.utils.pdf;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.List;
+
+import org.apache.pdfbox.Loader;
+import org.apache.pdfbox.pdmodel.PDDocument;
+import org.apache.pdfbox.pdmodel.PDPage;
+import org.apache.pdfbox.pdmodel.PDPageContentStream;
+import org.apache.pdfbox.pdmodel.common.PDRectangle;
+import org.apache.pdfbox.pdmodel.font.PDType1Font;
+import org.apache.pdfbox.pdmodel.font.Standard14Fonts;
+import org.apache.pdfbox.pdmodel.interactive.action.PDActionGoTo;
+import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotation;
+import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationLink;
+import org.apache.pdfbox.pdmodel.interactive.documentnavigation.destination.PDPageXYZDestination;
+import org.apache.pdfbox.text.PDFTextStripper;
+import org.apache.pdfbox.text.TextPosition;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+/**
+ * Tests the page scale that brings the renderer's pages to html-pdf's one CSS pixel per point (task T11).
+ */
+public class PdfPageScalerTest {
+
+  private static byte[] pageWithTextAndLink() throws IOException {
+    try (PDDocument document = new PDDocument()) {
+      PDPage page = new PDPage(new PDRectangle(600, 800));
+      document.addPage(page);
+      try (PDPageContentStream content = new PDPageContentStream(document, page)) {
+        content.beginText();
+        content.setFont(new PDType1Font(Standard14Fonts.FontName.HELVETICA), 20);
+        content.newLineAtOffset(100, 700);
+        content.showText("scaled");
+        content.endText();
+      }
+      PDAnnotationLink link = new PDAnnotationLink();
+      link.setRectangle(new PDRectangle(100, 690, 120, 30));
+      PDActionGoTo action = new PDActionGoTo();
+      PDPageXYZDestination destination = new PDPageXYZDestination();
+      destination.setPage(page);
+      destination.setLeft(200);
+      destination.setTop(400);
+      action.setDestination(destination);
+      link.setAction(action);
+      page.getAnnotations().add(link);
+      ByteArrayOutputStream out = new ByteArrayOutputStream();
+      document.save(out);
+      return out.toByteArray();
+    }
+  }
+
+  private static final class Positions extends PDFTextStripper {
+
+    private final StringBuilder text = new StringBuilder();
+    private TextPosition first;
+    private float width;
+
+    Positions() throws IOException {
+      super();
+    }
+
+    @Override
+    protected void writeString(String string, List<TextPosition> positions) {
+      text.append(string);
+      if (first == null && !positions.isEmpty()) {
+        first = positions.get(0);
+      }
+      for (TextPosition position : positions) {
+        width += position.getWidthDirAdj();
+      }
+    }
+  }
+
+  @Test
+  public void thePageBoxTheTextAndTheLinkAllFollowTheFactor() throws IOException {
+    try (PDDocument document = Loader.loadPDF(pageWithTextAndLink())) {
+      PdfPageScaler.scale(document, 0.5);
+      PDPage page = document.getPage(0);
+      assertEquals(300, page.getMediaBox().getWidth(), 0.01);
+      assertEquals(400, page.getMediaBox().getHeight(), 0.01);
+      Positions positions = new Positions();
+      positions.getText(document);
+      assertEquals("scaled", positions.text.toString().trim());
+      // "scaled" at 20 pt Helvetica is 20 * (500 + 500 + 556 + 222 + 556 + 556) / 1000 = 57.8 pt wide
+      assertEquals("the text width on the page", 57.8 / 2, positions.width, 0.1);
+      assertEquals("x", 50.0, positions.first.getXDirAdj(), 0.01);
+      assertEquals("y from the top", 400 - 350.0, positions.first.getYDirAdj(), 0.5);
+      PDAnnotationLink link = (PDAnnotationLink) page.getAnnotations().get(0);
+      PDRectangle rectangle = link.getRectangle();
+      assertEquals(50, rectangle.getLowerLeftX(), 0.01);
+      assertEquals(345, rectangle.getLowerLeftY(), 0.01);
+      assertEquals(60, rectangle.getWidth(), 0.01);
+      assertEquals(15, rectangle.getHeight(), 0.01);
+      PDPageXYZDestination destination = (PDPageXYZDestination) ((PDActionGoTo) link.getAction()).getDestination();
+      assertEquals(100, destination.getLeft());
+      assertEquals(200, destination.getTop());
+    }
+  }
+
+  @Test
+  public void theScaleSurvivesASaveAndReload() throws IOException {
+    ByteArrayOutputStream out = new ByteArrayOutputStream();
+    try (PDDocument document = Loader.loadPDF(pageWithTextAndLink())) {
+      PdfPageScaler.scale(document, 2.0 / 3.0);
+      document.save(out);
+    }
+    try (PDDocument reloaded = Loader.loadPDF(out.toByteArray())) {
+      assertEquals(400, reloaded.getPage(0).getMediaBox().getWidth(), 0.01);
+      Positions positions = new Positions();
+      positions.getText(reloaded);
+      assertEquals(57.8 * 2.0 / 3.0, positions.width, 0.1);
+    }
+  }
+
+  private static int contentStreamsOf(PDPage page) throws IOException {
+    int count = 0;
+    java.util.Iterator<org.apache.pdfbox.pdmodel.common.PDStream> streams = page.getContentStreams();
+    while (streams.hasNext()) {
+      streams.next();
+      count++;
+    }
+    return count;
+  }
+
+  @Test
+  public void aFactorOfOneLeavesTheDocumentAlone() throws IOException {
+    try (PDDocument document = Loader.loadPDF(pageWithTextAndLink())) {
+      int before = contentStreamsOf(document.getPage(0));
+      PdfPageScaler.scale(document, 1.0);
+      assertEquals(600, document.getPage(0).getMediaBox().getWidth(), 0.0001);
+      assertEquals("no matrix is wrapped around the content", before, contentStreamsOf(document.getPage(0)));
+    }
+  }
+
+  @Test
+  public void aCropBoxIsScaledToo() throws IOException {
+    try (PDDocument document = Loader.loadPDF(pageWithTextAndLink())) {
+      document.getPage(0).setCropBox(new PDRectangle(10, 20, 400, 600));
+      PdfPageScaler.scale(document, 0.5);
+      PDRectangle crop = document.getPage(0).getCropBox();
+      assertEquals(5, crop.getLowerLeftX(), 0.01);
+      assertEquals(10, crop.getLowerLeftY(), 0.01);
+      assertEquals(200, crop.getWidth(), 0.01);
+      assertEquals(300, crop.getHeight(), 0.01);
+    }
+  }
+
+  @Test
+  public void everyAnnotationOfThePageIsVisited() throws IOException {
+    try (PDDocument document = Loader.loadPDF(pageWithTextAndLink())) {
+      PDPage page = document.getPage(0);
+      PDAnnotationLink second = new PDAnnotationLink();
+      second.setRectangle(new PDRectangle(10, 10, 20, 20));
+      page.getAnnotations().add(second);
+      PdfPageScaler.scale(document, 0.5);
+      List<PDAnnotation> annotations = page.getAnnotations();
+      assertEquals(2, annotations.size());
+      assertEquals(5, annotations.get(1).getRectangle().getLowerLeftX(), 0.01);
+      assertEquals(10, annotations.get(1).getRectangle().getWidth(), 0.01);
+    }
+  }
+}
diff --git a/marlo-web/src/test/java/org/cgiar/ccafs/marlo/utils/pdf/TrueTypeTablesTest.java b/marlo-web/src/test/java/org/cgiar/ccafs/marlo/utils/pdf/TrueTypeTablesTest.java
