<configuration>
  <contextName>Marlo Activities</contextName>
  <!-- Same default as ApplicationContextConfig ("dev"): without it, a JVM started with no spring.profiles.active loads
    no properties, writes to log.folder_IS_UNDEFINED/ and attaches no appender, while Spring runs as dev -->
  <property resource="config/marlo-${spring.profiles.active:-dev}.properties" />

  <!-- ======= Filters by levels to print logs in file ======= -->

  <appender name="FILE-PRODUCTION"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log.folder}/marlo.log</file>
    <!-- deny all events with a level below INFO, that is TRACE and DEBUG -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}]%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <!-- 30 days, daily rollover -->   
        <fileNamePattern>${log.folder}/marlo.%d{yyyy-MM-dd}.zip</fileNamePattern>
        <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <appender name="FILE-TEST"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log.folder}/marlo-${log.instance}.log</file>
    <encoder>     
    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}]%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>    
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <!-- 30 days, daily rollover -->   
        <fileNamePattern>${log.folder}/marlo-test-${log.instance}.%d{yyyy-MM-dd}.zip</fileNamePattern>
        <maxHistory>30</maxHistory>
    </rollingPolicy>     
</appender>


  <!-- ======= Filters by levels to print logs in Console ======= -->

  <appender name="CONSOLE-PRODUCTION" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}]%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="CONSOLE-TEST" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}]%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ======= Only show error messages from the framework ======= -->
  <logger name="org.apache.struts2">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.struts2.components">
    <level value="WARN" />
  </logger>
  <logger name="com.opensymphony.xwork2">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.shiro">
    <level value="WARN" />
  </logger>
  <logger name="org.hibernate">
    <level value="WARN" />
  </logger>
  <logger name="org.flywaydb">
    <level value="INFO" />
  </logger>
  <logger name="org.apache.tomcat">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.catalina">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.coyote">
    <level value="WARN" />
  </logger>
  <logger name="org.pentaho">
    <level value="WARN" />
  </logger>
  <logger name="com.zaxxer.hikari">
    <level value="WARN" />
  </logger>
  <logger name="org.springframework">
    <level value="INFO" />
  </logger>
  <logger name="springfox.documentation">
    <level value="INFO" />
  </logger>
  <logger name="net.sf.ehcache">
    <level value="INFO" />
  </logger>
  <!-- The sizeOfPolicy maxDepth=0 in ehcache.xml makes these two classes warn on every cache size calculation,
    which floods the log. They are scoped by class, not by package, so the one-off accuracy advisories from
    AgentLoader, ReflectionSizeOf and UnsafeSizeOf are still reported. Both classes are listed because the WAR
    ships two ehcache jars (2.10.6 and core 2.5.1) whose duplicate classes emit this warning from different
    places, and which one wins depends on classpath order. -->
  <logger name="net.sf.ehcache.pool.sizeof.SizeOf">
    <level value="ERROR" />
  </logger>
  <logger name="net.sf.ehcache.pool.sizeof.ObjectGraphWalker">
    <level value="ERROR" />
  </logger>

  
 
  <!-- ======= Attach the appenders according to the configuration properties 
    ======= -->
  <root level="ALL">
    <if condition='property("log.console").equalsIgnoreCase("true")'>
      <then>

        <if condition='property("log.production").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="CONSOLE-PRODUCTION" />
          </then>
        </if>

        <if condition='property("log.test").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="CONSOLE-TEST" />
          </then>
        </if>

      </then>
    </if>

    <if condition='property("log.file").equalsIgnoreCase("true")'>
      <then>

        <if condition='property("log.production").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="FILE-PRODUCTION" />
          </then>
        </if>

        <if condition='property("log.test").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="FILE-TEST" />
          </then>
        </if>

      </then>
    </if>
  </root>
</configuration>