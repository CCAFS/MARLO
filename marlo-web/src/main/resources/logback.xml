<configuration>
  <contextName>Marlo Activities</contextName>
  <!-- Same default as ApplicationContextConfig ("dev"): without it, a JVM started with no spring.profiles.active loads
    no properties, writes to log.folder_IS_UNDEFINED/ and attaches no appender, while Spring runs as dev -->
  <property resource="config/marlo-${spring.profiles.active:-dev}.properties" />

  <!-- environment field of every line (DEV, TEST or PROD), derived from the Spring profile; marlo.environment, set as a
    system property or in the properties file above, overrides it. See LogEnvironmentDefiner for every value -->
  <define name="environment" scope="context" class="org.cgiar.ccafs.marlo.logging.LogEnvironmentDefiner">
    <profiles>${spring.profiles.active:-dev}</profiles>
    <override>${marlo.environment:-}</override>
  </define>

  <!-- ======= Filters by levels to print logs in file ======= -->

  <appender name="FILE-PRODUCTION"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log.folder}/marlo.log</file>
    <!-- deny all events with a level below INFO, that is TRACE and DEBUG -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}] environment=${environment:-UNKNOWN}%replace( request_id=%X{request_id}){'^ request_id=$', ''}%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( user_email=%X{user_email}){'^ user_email=$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <!-- 30 days, daily rollover -->   
        <fileNamePattern>${log.folder}/marlo.%d{yyyy-MM-dd}.zip</fileNamePattern>
        <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <appender name="FILE-TEST"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log.folder}/marlo-${log.instance}.log</file>
    <encoder>     
    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}] environment=${environment:-UNKNOWN}%replace( request_id=%X{request_id}){'^ request_id=$', ''}%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( user_email=%X{user_email}){'^ user_email=$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>    
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <!-- 30 days, daily rollover -->   
        <fileNamePattern>${log.folder}/marlo-test-${log.instance}.%d{yyyy-MM-dd}.zip</fileNamePattern>
        <maxHistory>30</maxHistory>
    </rollingPolicy>     
</appender>


  <!-- ======= JSON log: one JSON object per line, switched by log.json (ENH-LOGGING-STANDARDIZATION-001) =======
    Every JSON field name is declared in the providers block below (NF-004). The MDC fields that need a type or a
    condition are written by MarloMdcJsonProvider: status_code and user_id as numbers, user_name and user_email only
    on a status_code of 400 or more, and never service_affected. The framework logger levels below apply to this
    appender too, because they are scoped by logger and not by appender.
    The appender is declared only when log.json is true: logback creates the file of every appender it declares, even
    one that no logger uses, so a declared FILE-JSON would leave an empty file where the JSON log is switched off. -->
  <if condition='property("log.json").equalsIgnoreCase("true")'>
    <then>
      <appender name="FILE-JSON"
        class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.folder}/marlo-json-${log.instance}.log</file>
        <!-- like FILE-PRODUCTION, a production server denies all events with a level below INFO -->
        <if condition='property("log.production").equalsIgnoreCase("true")'>
          <then>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
              <level>INFO</level>
            </filter>
          </then>
        </if>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
          <providers>
            <timestamp>
              <fieldName>timestamp</fieldName>
              <timeZone>UTC</timeZone>
            </timestamp>
            <logLevel>
              <fieldName>level</fieldName>
            </logLevel>
            <globalCustomFields>
              <customFields>{"environment":"${environment:-UNKNOWN}"}</customFields>
            </globalCustomFields>
            <loggerName>
              <fieldName>module_section</fieldName>
            </loggerName>
            <!-- The string fields of the request context. The MDC keys are the field names -->
            <mdc>
              <includeMdcKeyName>request_id</includeMdcKeyName>
              <includeMdcKeyName>tool_name</includeMdcKeyName>
              <includeMdcKeyName>controller_affected</includeMdcKeyName>
            </mdc>
            <provider class="org.cgiar.ccafs.marlo.logging.MarloMdcJsonProvider">
              <statusCodeFieldName>status_code</statusCodeFieldName>
              <userIdFieldName>user_id</userIdFieldName>
              <userNameFieldName>user_name</userNameFieldName>
              <userEmailFieldName>user_email</userEmailFieldName>
            </provider>
            <message>
              <fieldName>message</fieldName>
            </message>
            <!-- SEC-003: the trace is cut at maxLength characters, and each throwable at maxDepthPerThrowable frames -->
            <stackTrace>
              <fieldName>stack_trace</fieldName>
              <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>8192</maxLength>
                <shortenedClassNameLength>40</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
              </throwableConverter>
            </stackTrace>
          </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 30 days, daily rollover -->
            <fileNamePattern>${log.folder}/marlo-json-${log.instance}.%d{yyyy-MM-dd}.zip</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
      </appender>
    </then>
  </if>


  <!-- ======= Filters by levels to print logs in Console ======= -->

  <appender name="CONSOLE-PRODUCTION" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}] environment=${environment:-UNKNOWN}%replace( request_id=%X{request_id}){'^ request_id=$', ''}%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( user_email=%X{user_email}){'^ user_email=$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="CONSOLE-TEST" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} - [%thread] [%-5level] [MARLO] [${spring.profiles.active:-dev}] [%logger{0}] environment=${environment:-UNKNOWN}%replace( request_id=%X{request_id}){'^ request_id=$', ''}%replace( tool_name=%X{tool_name}){'^ tool_name=$', ''}%replace( user_id=%X{user_id}){'^ user_id=$', ''}%replace( user_name="%X{user_name}"){'^ user_name=""$', ''}%replace( user_email=%X{user_email}){'^ user_email=$', ''}%replace( controller_affected=%X{controller_affected}){'^ controller_affected=$', ''}%replace( status_code=%X{status_code}){'^ status_code=$', ''}: %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ======= Only show error messages from the framework ======= -->
  <logger name="org.apache.struts2">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.struts2.components">
    <level value="WARN" />
  </logger>
  <logger name="com.opensymphony.xwork2">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.shiro">
    <level value="WARN" />
  </logger>
  <logger name="org.hibernate">
    <level value="WARN" />
  </logger>
  <logger name="org.flywaydb">
    <level value="INFO" />
  </logger>
  <logger name="org.apache.tomcat">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.catalina">
    <level value="WARN" />
  </logger>
  <logger name="org.apache.coyote">
    <level value="WARN" />
  </logger>
  <logger name="org.pentaho">
    <level value="WARN" />
  </logger>
  <logger name="com.zaxxer.hikari">
    <level value="WARN" />
  </logger>
  <logger name="org.springframework">
    <level value="INFO" />
  </logger>
  <logger name="springfox.documentation">
    <level value="INFO" />
  </logger>
  <logger name="net.sf.ehcache">
    <level value="INFO" />
  </logger>
  <!-- The sizeOfPolicy maxDepth=0 in ehcache.xml makes these two classes warn on every cache size calculation,
    which floods the log. They are scoped by class, not by package, so the one-off accuracy advisories from
    AgentLoader, ReflectionSizeOf and UnsafeSizeOf are still reported. Both classes are listed because the WAR
    ships two ehcache jars (2.10.6 and core 2.5.1) whose duplicate classes emit this warning from different
    places, and which one wins depends on classpath order. -->
  <logger name="net.sf.ehcache.pool.sizeof.SizeOf">
    <level value="ERROR" />
  </logger>
  <logger name="net.sf.ehcache.pool.sizeof.ObjectGraphWalker">
    <level value="ERROR" />
  </logger>

  
 
  <!-- ======= Attach the appenders according to the configuration properties 
    ======= -->
  <root level="ALL">
    <if condition='property("log.console").equalsIgnoreCase("true")'>
      <then>

        <if condition='property("log.production").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="CONSOLE-PRODUCTION" />
          </then>
        </if>

        <if condition='property("log.test").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="CONSOLE-TEST" />
          </then>
        </if>

      </then>
    </if>

    <if condition='property("log.file").equalsIgnoreCase("true")'>
      <then>

        <if condition='property("log.production").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="FILE-PRODUCTION" />
          </then>
        </if>

        <if condition='property("log.test").equalsIgnoreCase("true")'>
          <then>
            <appender-ref ref="FILE-TEST" />
          </then>
        </if>

      </then>
    </if>

    <if condition='property("log.json").equalsIgnoreCase("true")'>
      <then>
        <appender-ref ref="FILE-JSON" />
      </then>
    </if>
  </root>
</configuration>