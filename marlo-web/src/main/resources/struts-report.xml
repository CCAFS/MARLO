<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuration 2.5//EN" 
  "http://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
	<!-- Add addition packages and configuration here. -->
	<package name="report" namespace="/report"
		extends="marlo-default">

		<action name="{crp}/sendOICRsQueueMessage" method="sendOICRsQueueMessage"
			class="org.cgiar.ccafs.marlo.action.report.MicroserviceReportAction">
			<interceptor-ref name="homeStack" />
			<!-- Fire-and-forget endpoint: it enqueues a message and renders no view, so both
			     outcomes are plain HTTP status codes. Without a mapped "error" result Struts
			     raises "No result defined", which the global Exception mapping turns into an
			     unhandled-exception page and email. -->
			<result name="success" type="httpheader">
				<param name="status">200</param>
			</result>
			<result name="error" type="httpheader">
				<param name="status">500</param>
			</result>
		</action>
		
		<action name="{crp}/fetchPDF" method="fetchPDF"
			class="org.cgiar.ccafs.marlo.action.report.MicroserviceReportAction">
			<interceptor-ref name="homeStack" />		
    		<result name="success"></result>
		</action>

	</package>

</struts>
