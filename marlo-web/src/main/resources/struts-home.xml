<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuration 2.5//EN" 
  "http://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <package name="homeJson" namespace="/" extends="json-default">
  
		 <action name="crpByEmail" class="org.cgiar.ccafs.marlo.action.json.global.CrpByUserEmailAction">
	    <result type="json">
	      <param name="noCache">true</param>
	    </result>
	   </action>
	   
	   <action name="validateUser"
      class="org.cgiar.ccafs.marlo.action.json.global.ValidateUserAction">
      <result type="json">
        <param name="noCache">true</param>
        <param name="excludeNullProperties">true</param>
      </result>
    </action>
	   
  </package>
	<!--
		CHG-OTP-LOGIN-001-T12 (design.md 4, DD-1): the pre-authentication JSON endpoints of the Center email
		one-time-code sign-in. They live in their own package, not in homeJson (which has neither logErrorStatus
		nor i18nFile) and not in home (a root-less JSON result on a LoginAction subclass would serialise every
		getter, JD-5): the "json" result type comes from json-default (P-26) and the standard marlo-default
		stacks stay available. otpUnloggedStack is cognitoUnloggedStack's interceptors, for the same reason
		(design.md 8): unloggedStack's validCrp and validSessionCrp 404 a flat action name. Only the "response"
		map of the action is serialised (SEC-004). The global "input" result answers the same JSON, so a
		conversion or validation interruption answers {status: unavailable} and never a 500 or a login page
		(RJ-9). Both actions implement ParameterNameAware and accept only their own request parameters.
	-->
	<package name="homeOtp" namespace="/" extends="marlo-default,json-default">

		<interceptors>
			<interceptor-stack name="otpUnloggedStack">
				<interceptor-ref name="logErrorStatus" />
				<interceptor-ref name="i18nFile" />
				<interceptor-ref name="defaultStack" />
			</interceptor-stack>
		</interceptors>

		<global-results>
			<result name="input" type="json">
				<param name="root">response</param>
				<param name="noCache">true</param>
				<param name="excludeNullProperties">true</param>
			</result>
		</global-results>

		<action name="otpRequestCode" class="org.cgiar.ccafs.marlo.action.home.OtpRequestCodeAction">
			<interceptor-ref name="otpUnloggedStack" />
			<result name="success" type="json">
				<param name="root">response</param>
				<param name="noCache">true</param>
				<param name="excludeNullProperties">true</param>
			</result>
		</action>

		<action name="otpVerifyCode" class="org.cgiar.ccafs.marlo.action.home.OtpVerifyCodeAction">
			<interceptor-ref name="otpUnloggedStack" />
			<result name="success" type="json">
				<param name="root">response</param>
				<param name="noCache">true</param>
				<param name="excludeNullProperties">true</param>
			</result>
		</action>

	</package>

	<!-- Add addition packages and configuration here. -->
	<package name="home" namespace="/" extends="marlo-default">

		<!--
			CHG-COGNITO-AUTH-001-T08/T09: cognitoLogin.do and cognitoCallback.do are flat action names (no
			{crp}/ prefix), matching login.do/logout.do above — the Global Unit is not yet known from the URL
			at authorize time. design.md 8 and tasks.md both say "register with unloggedStack", but that shared
			stack's validCrp and validSessionCrp interceptors (struts.xml) unconditionally split the action name
			on "/" and return NOT_FOUND when there is no second segment — verified against
			ValidCrpActionInterceptor and ValidSessionCrpInterceptor. Reusing unloggedStack verbatim would make
			both actions permanently unreachable (every request NOT_FOUND), which is exactly the "code correct
			in isolation, unreachable through the real framework" defect class this spec's own T06 audit found
			twice. This stack reproduces unloggedStack's actual intent for an unauthenticated, non-crp-prefixed
			action — i18n plus the standard param/validation pipeline, no requireUser — without the two
			interceptors that assume a {crp}/action URL shape. Named per TRD 4.3 rule 1; every interceptor it
			references is inherited from marlo-default (struts.xml), so nothing there needed to change.
		-->
		<interceptors>
			<interceptor-stack name="cognitoUnloggedStack">
				<interceptor-ref name="logErrorStatus" />
				<interceptor-ref name="i18nFile" />
				<interceptor-ref name="defaultStack" />
			</interceptor-stack>
		</interceptors>

		<action name="cognitoLogin" class="org.cgiar.ccafs.marlo.action.home.CognitoLoginAction">
			<interceptor-ref name="cognitoUnloggedStack" />
			<result name="input">
				<param name="location">/WEB-INF/global/views/login/login.ftl</param>
				<param name="model">action</param>
			</result>
			<result name="success" type="redirect">${authorizeUrl}</result>
		</action>

		<!--
			CHG-COGNITO-AUTH-001-T09: the redirect target Cognito returns to. Registered with the same
			cognitoUnloggedStack as cognitoLogin above, for the same reason (design.md 8): unloggedStack's
			validCrp/validSessionCrp interceptors split the action name on "/" and 404 a flat name before the
			action is ever entered. Result set mirrors "login" below (input/success/login) so the shared tail
			(finishLogin, T01) routes identically regardless of which action called it, and the input result
			exposes the same model surface as the "login" and "cognitoLogin" actions above (model=action, so
			whatever loginForm.ftl reads off the action, such as crpSession or listGlobalUnitTypes, resolves
			exactly as it does for them) so a refused callback renders login.ftl correctly instead of broken.
		-->
		<action name="cognitoCallback" class="org.cgiar.ccafs.marlo.action.home.CognitoCallbackAction">
			<interceptor-ref name="cognitoUnloggedStack" />
			<result name="input">
				<param name="location">/WEB-INF/global/views/login/login.ftl</param>
				<param name="model">action</param>
			</result>
			<result name="success" type="redirectAction">
			   <param name="actionName">${crpSession}/crpDashboard</param>
			</result>
			<result name="login" type="redirect">${url}</result>
		</action>

		<action name="login" class="org.cgiar.ccafs.marlo.action.home.LoginAction"
			method="login">
			<result name="input">
				<param name="location">/WEB-INF/global/views/login/login.ftl</param>
				<param name="model">action</param>
			</result>
			<result name="success" type="redirectAction">
			   <param name="actionName">${crpSession}/crpDashboard</param>
			</result>
		  <result name="login" type="redirect">${url}</result>
		</action>

	 <!-- 
		<action name="testCIATOCS" class="org.cgiar.ccafs.marlo.action.TestCIATOCSAction">
			<result name="success">/WEB-INF/global/pages/ocsMessage.ftl</result>
			<result name="input" type="httpheader">
				<param name="status">404</param>
				<param name="errorMessage">Not Found</param>
			</result>
		</action>
		 -->
		<action name="mapGeo" class="org.cgiar.ccafs.marlo.action.MapGeolocation">
      <result name="success">/WEB-INF/global/pages/ocsMessage.ftl</result>
    </action>

		<action name="logout" class="org.cgiar.ccafs.marlo.action.home.LoginAction"
			method="logout">
			<result name="success" type="redirectAction">
				<param name="actionName">login</param>
				<param name="namespace">/</param>
			</result>
		</action>

		<action name="{*}/crpDashboard"
			class="org.cgiar.ccafs.marlo.action.home.DashboardAction">
			<!-- interceptor-ref name="autoLogin" / -->
			<interceptor-ref name="homeStack" />
			<result name="input">/WEB-INF/crp/views/home/dashboard.ftl</result>
		</action>
	</package>

</struts>
