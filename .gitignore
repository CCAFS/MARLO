# General

target
.*
*.jks
!.gitignore
!.bowerrc
bin

# Configuration 
/configuration/marlo.properties

# Mainfest
*.MF
configuration/test/marlo.properties
configuration/dev/marlo.properties
marlo-web/src/main/resources/swagger/dist/swagger-ui-setup.js
marlo-web/src/main/java/org/cgiar/ccafs/marlo/validation/NewRole.java
marlo-web/src/main/java/org/cgiar/ccafs/marlo/validation/WelcomeEmail.java


# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
# AKILI-SPECS — committed on purpose (the leading `.*` rule above would otherwise swallow them).
# `.agents/` personas and `.claude/agents/` wrappers must be shared with the team; without this,
# every teammate and every future session gets an empty multi-agent harness.
!.agents/
!.claude/
.claude/*
!.claude/agents/
