# General

target
.*
*.jks
!.gitignore
!.bowerrc
bin

# AKILI-SPECS harness — must be committed despite the blanket `.*` rule above.
# `.agents/` holds the Leader/Implementer/Reviewer/Tester personas and `.claude/agents/`
# holds the thin model-binding wrappers. Both are project configuration that every
# teammate and every session needs, so they are explicitly re-included here.
!.agents/
!.agents/**
!.claude/
!.claude/agents/
!.claude/agents/**
# Keep local-only Claude Code state ignored.
.claude/settings.local.json
.claude/*.local.*

# Configuration 
/configuration/marlo.properties

# Mainfest
*.MF
configuration/test/marlo.properties
configuration/dev/marlo.properties
marlo-web/src/main/resources/swagger/dist/swagger-ui-setup.js
marlo-web/src/main/java/org/cgiar/ccafs/marlo/validation/NewRole.java
marlo-web/src/main/java/org/cgiar/ccafs/marlo/validation/WelcomeEmail.java


# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*