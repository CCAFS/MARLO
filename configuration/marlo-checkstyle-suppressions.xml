<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Suppressions for the logging guardrail (OPS-004), see marlo-checkstyle.xml.
  Generated 2026-10-27 by running the two rules over src/main/java and src/test/java of marlo-utils,
  marlo-data and marlo-web after T09-T12: only the files below still carry a hit. Remove an entry when
  its file is cleaned; never add one for new code.
  Notes: "id" is matched literally in Checkstyle 8.18 (no alternation, hence one entry per rule id), and
  "files" must match the whole absolute path, hence the leading and trailing .*
-->
<!-- ENH-PHASE-TYPE-UNIFICATION-001 NF-006: the REST layer looks phases up by name on purpose (its DTOs carry the
     name), so rest/ is outside the PhaseNameLiteral rule of marlo-checkstyle.xml. Checkstyle 8.18 has no
     SuppressionSingleFilter, so the exclusion lives in this file and names the rule by its id. -->
<suppressions>
  <suppress id="PhaseNameLiteral" files="[\\/]marlo[\\/]rest[\\/]"/>
  <!-- NF-006 covers main sources only. Tests may keep a deliberate name-literal fixture (for example
       PhaseNameSiteTruthTableTest, which pins the old behavior). RemovedPhaseTypeMethod (NF-003) still applies there. -->
  <suppress id="PhaseNameLiteral" files="[\\/]src[\\/]test[\\/]"/>
  <!-- marlo-web tests: ClientIpResolverTest prints diagnostics; SaveChainFailureLoggingTest redirects System.err. -->
  <suppress id="LoggingSystemOut" files=".*[\\/]marlo-web[\\/]src[\\/]test[\\/]java[\\/].*[\\/](ClientIpResolverTest|SaveChainFailureLoggingTest)\.java"/>
</suppressions>
